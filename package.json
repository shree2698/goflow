{
  "name": "goflow-root",
  "version": "1.0.0",
  "private": true,
  "description": "GoFlow root workspace runner",
  "scripts": {
    "dev:backend": "cd backend && go run ./cmd/server",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "install:frontend": "cd frontend && npm install",
    "test:backend": "cd backend && go test -v ./...",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "seed": "cd backend && go run ./cmd/seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
